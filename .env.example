# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/barcode

# Base Application URL (Production or Localhost)
NEXT_PUBLIC_APP_URL=https://barcode-taupe.vercel.app

# ==============================================================================
# Meta WhatsApp Business Cloud API Configuration
# Enter your Meta for Developers credentials here to enable automated template delivery.
# Documentation: https://developers.facebook.com/docs/whatsapp/cloud-api
# ==============================================================================

# Meta Phone Number ID (from WhatsApp > API Setup in Meta Developer Dashboard)
WHATSAPP_PHONE_NUMBER_ID=

# System User Permanent Access Token (or Temporary Token for testing)
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Name of your pre-approved WhatsApp message template in Meta Business Manager
WHATSAPP_TEMPLATE_NAME=bill_receipt

# Language code of your WhatsApp template (e.g. en, en_US, hi)
WHATSAPP_TEMPLATE_LANGUAGE=en

# Default Country Code for normalizing mobile numbers (91 for India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ==============================================================================
# Store Details for Receipts & Messages
# ==============================================================================
STORE_NAME=RUNR KIDS
STORE_WEBSITE=https://runrkids.in/
STORE_PHONE=+91 9737998216
